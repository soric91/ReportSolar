# Base de Datos
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/informeappsolar

# Seguridad - CAMBIAR EN PRODUCCIÓN
SECRET_KEY=tu-clave-secreta-super-segura-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin - Credenciales iniciales
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=tu-contraseña-admin-segura
ADMIN_NAME=Administrador

# Supabase - service_role key (no la anon key). Requiere tabla "users" y
# bucket de Storage "app_report" ya creados: ver sección "Configurar Supabase" en el README.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-key-aqui
