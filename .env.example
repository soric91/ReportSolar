# ──────────────────────────────────────────────
# Variables de entorno para docker-compose.yml
# Copiar a ".env" en la raíz del proyecto y completar.
# NUNCA commitear el archivo ".env" real (ya está en .gitignore).
# ──────────────────────────────────────────────

# Backend FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Nginx (puerto público de la app)
NGINX_PORT=8000

# Frontend (Vite dev server)
FRONTEND_PORT=5173

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin inicial (lo crea backend/seed_admin.py al levantar el backend)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Supabase — ver sección "Configurar Supabase" en el README
# SUPABASE_URL: URL del proyecto, ej. https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY: service_role key (NO la anon key, esta es secreta)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
